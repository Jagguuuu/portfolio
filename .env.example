# Copy to .env.local and fill in. Never commit real secrets.

# Formspree form ID (the part after /f/ in https://formspree.io/f/xxxxxxx).
# If empty, the contact form shows a "not configured" notice and falls back to mailto.
VITE_FORMSPREE_ID=

# Public contact email used for the mailto fallback and copy button.
VITE_CONTACT_EMAIL=Jagguuu83@gmail.com

# Optional project link overrides
VITE_BLOOD450_LIVE_URL=
VITE_PROMS_GITHUB_URL=
